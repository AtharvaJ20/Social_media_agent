# Get a free Gemini API key at: https://aistudio.google.com/apikey
#
# IMPORTANT — use a DIFFERENT key here from the one in your GitHub Secret GEMINI_API_KEY.
# Both keys share the same free-tier daily quota (1,500 requests/day) when they belong
# to the same Google AI Studio project. Heavy local testing will exhaust the workflow's
# quota and the 9 AM email will fail that day.
#
# Setup: create two keys at aistudio.google.com/apikey (one for local, one for GitHub),
# or use two separate Google accounts to get fully independent quota pools.
GEMINI_API_KEY=your_gemini_api_key_here

# Get a free Resend API key at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here

PORT=3001
